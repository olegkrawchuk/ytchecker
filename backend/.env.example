# -------------------------------------------------------
# YouTube Copyright Checker — Environment Variables
# Copy this file to .env and fill in your keys
# -------------------------------------------------------

# AudD API — track recognition (required for real checks)
# Register at: https://dashboard.audd.io/
# Free tier: 300 requests included
AUDD_API_TOKEN=

# YouTube Data API v3 — region/license signals (optional but recommended)
# Enable at: https://console.cloud.google.com → YouTube Data API v3
# Free tier: 10,000 units/day
YOUTUBE_DATA_API_KEY=

# ACRCloud — right_policy field (optional, 14-day free trial)
# Register at: https://www.acrcloud.com/
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# App settings
MOCK_MODE=false          # Set to true for dev without real API keys
CACHE_TTL_SECONDS=21600  # 6 hours

# Redis cache (optional — leave empty for in-memory cache)
REDIS_URL=

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
